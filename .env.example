# Esport Hub Environment Variables Template

# Backend Server Port
PORT=5000

# Client Frontend Origin (CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Leave empty or set to local/Atlas URI; will fallback to in-memory if unavailable)
MONGODB_URI=mongodb://localhost:27017/esport_hub

# JWT Authentication Secret
JWT_SECRET=esport-hub-jwt-secret-key-production-grade-2026

# Cookie Signing Key
COOKIE_SECRET=esport-hub-cookie-signing-key

# AES-256 Room Credential Encryption Key
ROOM_ENCRYPTION_KEY=esport-hub-aes256-super-secret-vault-key-32b
